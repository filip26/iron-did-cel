<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.apicatalog</groupId>
  <artifactId>iron-did-cel-resolver</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <name>Iron did:cel Resolver</name>

  <description>
    Resolves did:cel identifiers and validates the cryptographic event log (CEL)
    to assemble the DID Document
  </description>

  <url>https://github.com/filip26/iron-did-cel</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <issueManagement>
    <system>github</system>
    <url>https://github.com/filip26/iron-did-cel/issues</url>
  </issueManagement>

  <scm>
    <connection>scm:git:git://github.com/filip26/iron-did-cel.git</connection>
    <developerConnection>
      scm:git:git://github.com/filip26/iron-did-cel.git</developerConnection>
    <url>https://github.com/filip26/iron-did-cel/tree/main</url>
  </scm>

  <developers>
    <developer>
      <id>filip26</id>
      <name>Filip Kolarik</name>
      <email>filip26@gmail.com</email>
      <roles>
        <role>author</role>
      </roles>
    </developer>
  </developers>

  <inceptionYear>2026</inceptionYear>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <argLine>-Dfile.encoding=UTF-8</argLine>

    <multibase.version>4.1.0</multibase.version>
    <multicodec.version>2.4.0</multicodec.version>
    <titanium-jcs.version>3.0.0-M3</titanium-jcs.version>
    <jakarta.json.version>2.0.1</jakarta.json.version>

    <junit.version>6.0.3</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.apicatalog</groupId>
      <artifactId>copper-multibase</artifactId>
      <version>${multibase.version}</version>
    </dependency>
    <dependency>
      <groupId>com.apicatalog</groupId>
      <artifactId>copper-multicodec</artifactId>
      <version>${multicodec.version}</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish</groupId>
      <artifactId>jakarta.json</artifactId>
      <version>${jakarta.json.version}</version>
    </dependency>
    <dependency>
      <groupId>com.apicatalog</groupId>
      <artifactId>titanium-jcs</artifactId>
      <version>${titanium-jcs.version}</version>
    </dependency>
    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
      </plugin>
    </plugins>
  </build>
</project>
